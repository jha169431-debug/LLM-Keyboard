<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#46515D6C"
                android:endColor="#3A3E4754" />

            <stroke
                android:width="1dp"
                android:color="#38FFFFFF" />

            <corners android:radius="13dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#333943"
                android:endColor="#292E36" />

            <stroke
                android:width="1dp"
                android:color="#1FFFFFFF" />

            <corners android:radius="13dp" />
        </shape>
    </item>

</selector>
