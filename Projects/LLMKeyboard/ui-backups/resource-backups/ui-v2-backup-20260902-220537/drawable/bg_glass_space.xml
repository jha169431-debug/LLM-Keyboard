<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#4A525E6B"
                android:endColor="#3C3D4651" />

            <stroke
                android:width="1dp"
                android:color="#35FFFFFF" />

            <corners android:radius="15dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#353B45"
                android:endColor="#2A3038" />

            <stroke
                android:width="1dp"
                android:color="#20FFFFFF" />

            <corners android:radius="15dp" />
        </shape>
    </item>

</selector>
