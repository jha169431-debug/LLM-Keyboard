<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#4A46515F"
                android:endColor="#3B333B46" />

            <stroke
                android:width="1dp"
                android:color="#32FFFFFF" />

            <corners android:radius="13dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#303640"
                android:endColor="#252A31" />

            <stroke
                android:width="1dp"
                android:color="#18FFFFFF" />

            <corners android:radius="13dp" />
        </shape>
    </item>

</selector>
