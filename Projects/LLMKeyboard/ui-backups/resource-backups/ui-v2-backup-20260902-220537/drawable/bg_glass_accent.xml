<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#7DB7FF"
                android:endColor="#4D87D2" />

            <stroke
                android:width="1dp"
                android:color="#90D5EBFF" />

            <corners android:radius="14dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#669FE8"
                android:endColor="#477CC1" />

            <stroke
                android:width="1dp"
                android:color="#55D5EBFF" />

            <corners android:radius="14dp" />
        </shape>
    </item>

</selector>
