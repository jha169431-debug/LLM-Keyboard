<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">

            <gradient
                android:angle="270"
                android:startColor="#FFFFFFFF"
                android:endColor="#FFE7EDF2" />

            <stroke
                android:width="1dp"
                android:color="#B8FFFFFF" />

            <corners android:radius="7dp" />

        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">

            <gradient
                android:angle="270"
                android:startColor="#DFFFFFFF"
                android:endColor="#BEE7ECF1" />

            <stroke
                android:width="1dp"
                android:color="#D0FFFFFF" />

            <corners android:radius="7dp" />

        </shape>
    </item>

</selector>
