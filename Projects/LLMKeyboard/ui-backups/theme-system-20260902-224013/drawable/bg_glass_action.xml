<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">

            <gradient
                android:angle="270"
                android:startColor="#FFF9FBFC"
                android:endColor="#FFD9E1E8" />

            <stroke
                android:width="1dp"
                android:color="#CFFFFFFF" />

            <corners android:radius="8dp" />

        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">

            <gradient
                android:angle="270"
                android:startColor="#E6F3F6F8"
                android:endColor="#CEDCE3E9" />

            <stroke
                android:width="1dp"
                android:color="#BFFFFFFF" />

            <corners android:radius="8dp" />

        </shape>
    </item>

</selector>
