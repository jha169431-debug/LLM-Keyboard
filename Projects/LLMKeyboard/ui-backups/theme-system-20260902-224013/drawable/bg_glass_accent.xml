<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">

            <gradient
                android:angle="270"
                android:startColor="#FFF3FAFF"
                android:endColor="#FFBDD8EA" />

            <stroke
                android:width="1dp"
                android:color="#E6FFFFFF" />

            <corners android:radius="9dp" />

        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">

            <gradient
                android:angle="270"
                android:startColor="#EAF5FBFF"
                android:endColor="#D2C9DFEC" />

            <stroke
                android:width="1dp"
                android:color="#E0FFFFFF" />

            <corners android:radius="9dp" />

        </shape>
    </item>

</selector>
