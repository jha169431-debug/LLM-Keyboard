<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ===================================================== -->
    <!-- LETTER KEYS                                           -->
    <!-- ===================================================== -->

    <style name="KeyboardKey">

        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>

        <item name="android:layout_marginStart">3dp</item>
        <item name="android:layout_marginEnd">3dp</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:layout_marginBottom">3dp</item>

        <item name="android:background">@drawable/bg_glass_key</item>
        <item name="android:backgroundTint">@null</item>

        <!-- Dark graphite text -->
        <item name="android:textColor">#FF1D242B</item>
        <item name="android:textSize">19sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>

        <item name="android:textAllCaps">false</item>
        <item name="android:includeFontPadding">false</item>

        <item name="android:gravity">center</item>
        <item name="android:padding">0dp</item>

        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>

        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>

        <item name="android:letterSpacing">0.01</item>

    </style>


    <!-- ===================================================== -->
    <!-- NUMBER ROW                                            -->
    <!-- ===================================================== -->

    <style name="KeyboardKeySmall"
        parent="KeyboardKey">

        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#C8273038</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>

    </style>


    <!-- ===================================================== -->
    <!-- ACTION KEYS                                           -->
    <!-- ===================================================== -->

    <style name="KeyboardActionKey"
        parent="KeyboardKey">

        <item name="android:background">@drawable/bg_glass_action</item>

        <item name="android:textColor">#E5222930</item>

        <item name="android:fontFamily">sans-serif-medium</item>

        <item name="android:letterSpacing">0</item>

    </style>


    <!-- ===================================================== -->
    <!-- SPACE                                                 -->
    <!-- ===================================================== -->

    <style name="KeyboardSpaceKey"
        parent="KeyboardKey">

        <item name="android:background">@drawable/bg_glass_space</item>

        <item name="android:textColor">#B8222930</item>

        <item name="android:textSize">12sp</item>

        <item name="android:fontFamily">sans-serif-medium</item>

        <item name="android:letterSpacing">0.02</item>

    </style>


    <!-- ===================================================== -->
    <!-- ENTER                                                 -->
    <!-- ===================================================== -->

    <style name="KeyboardAccentKey"
        parent="KeyboardKey">

        <item name="android:background">@drawable/bg_glass_accent</item>

        <item name="android:textColor">#FF24313A</item>

        <item name="android:fontFamily">sans-serif-medium</item>

        <item name="android:letterSpacing">0</item>

    </style>

</resources>
