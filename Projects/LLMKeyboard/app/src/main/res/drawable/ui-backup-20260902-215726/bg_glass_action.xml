<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#48AAB6C8"
                android:endColor="#283B424F" />
            <stroke
                android:width="1dp"
                android:color="#55FFFFFF" />
            <corners android:radius="10dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#303B424F"
                android:endColor="#22141920" />
            <stroke
                android:width="1dp"
                android:color="#2DFFFFFF" />
            <corners android:radius="10dp" />
        </shape>
    </item>

</selector>
