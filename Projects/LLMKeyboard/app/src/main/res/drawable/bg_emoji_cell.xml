<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">

            <gradient
                android:angle="270"
                android:startColor="@color/kb_key_pressed_top"
                android:endColor="@color/kb_key_pressed_bottom" />

            <stroke
                android:width="1dp"
                android:color="@color/kb_key_border" />

            <corners android:radius="8dp" />

        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">

            <gradient
                android:angle="270"
                android:startColor="@color/kb_key_top"
                android:endColor="@color/kb_key_bottom" />

            <stroke
                android:width="1dp"
                android:color="@color/kb_key_border" />

            <corners android:radius="8dp" />

        </shape>
    </item>

</selector>
