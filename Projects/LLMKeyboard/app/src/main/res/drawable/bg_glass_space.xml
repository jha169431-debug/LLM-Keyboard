<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#F1DEE2E6" />
            <corners android:radius="10dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">

            <gradient
                android:angle="270"
                android:startColor="#FAFFFFFF"
                android:endColor="#F6F3F4F6" />

            <stroke
                android:width="0.5dp"
                android:color="#70BFC3C8" />

            <corners android:radius="10dp" />

        </shape>
    </item>

</selector>
