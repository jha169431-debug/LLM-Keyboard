<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#E580B8FF"
                android:endColor="#B94C80C9" />
            <stroke
                android:width="1dp"
                android:color="#88D7ECFF" />
            <corners android:radius="11dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#C95C9DEB"
                android:endColor="#98416FA8" />
            <stroke
                android:width="1dp"
                android:color="#66D7ECFF" />
            <corners android:radius="11dp" />
        </shape>
    </item>

</selector>
