<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="4dp"
    android:background="#101114">

    <!-- Number row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/key_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="1"
            android:textColor="#FFFFFF"
            android:background="#25282D"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="2"
            android:textColor="#FFFFFF"
            android:background="#25282D"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="3"
            android:textColor="#FFFFFF"
            android:background="#25282D"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="4"
            android:textColor="#FFFFFF"
            android:background="#25282D"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="5"
            android:textColor="#FFFFFF"
            android:background="#25282D"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_6"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="6"
            android:textColor="#FFFFFF"
            android:background="#25282D"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_7"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="7"
            android:textColor="#FFFFFF"
            android:background="#25282D"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_8"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="8"
            android:textColor="#FFFFFF"
            android:background="#25282D"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_9"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="9"
            android:textColor="#FFFFFF"
            android:background="#25282D"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="0"
            android:textColor="#FFFFFF"
            android:background="#25282D"
            android:padding="0dp" />

    </LinearLayout>

    <!-- QWERTY row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/key_q"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Q"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:background="#25282D"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_w"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="W"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:background="#25282D"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_e"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="E"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:background="#25282D"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_r"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="R"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:background="#25282D"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_t"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="T"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:background="#25282D"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_y"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Y"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:background="#25282D"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_u"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="U"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:background="#25282D"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_i"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="I"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:background="#25282D"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_o"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="O"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:background="#25282D"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_p"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="P"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:background="#25282D"
            android:padding="0dp" />

    </LinearLayout>

    <!-- ASDF row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <Button
            android:id="@+id/key_a"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="A"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:background="#25282D"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_s"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="S"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:background="#25282D"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_d"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="D"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:background="#25282D"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_f"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="F"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:background="#25282D"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_g"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="G"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:background="#25282D"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_h"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="H"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:background="#25282D"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_j"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="J"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:background="#25282D"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_k"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="K"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:background="#25282D"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_l"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="L"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:background="#25282D"
            android:padding="0dp" />

    </LinearLayout>

    <!-- ZXCV row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/key_shift"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.3"
            android:text="⇧"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:background="#25282D"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_z"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Z"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:background="#25282D"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_x"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="X"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:background="#25282D"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_c"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="C"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:background="#25282D"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_v"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="V"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:background="#25282D"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_b"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="B"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:background="#25282D"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_n"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="N"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:background="#25282D"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_m"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="M"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:background="#25282D"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_backspace"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.3"
            android:text="⌫"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:background="#25282D"
            android:padding="0dp" />

    </LinearLayout>

    <!-- Bottom row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/key_symbols"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.3"
            android:text="sym"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:background="#25282D"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_emoji"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.3"
            android:text=""
            android:drawableTop="@drawable/ic_emoji"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:background="#25282D"
            android:padding="0dp" />
        android:gravity="center" />

        <Button
            android:id="@+id/key_space"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="5"
            android:text="SPACE"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:background="#25282D"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_enter"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.3"
            android:text="↵"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:background="#25282D"
            android:padding="0dp" />

    </LinearLayout>

</LinearLayout>
