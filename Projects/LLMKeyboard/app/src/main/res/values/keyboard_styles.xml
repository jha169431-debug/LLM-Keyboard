<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="KeyboardKey">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>

        <item name="android:layout_marginStart">1dp</item>
        <item name="android:layout_marginEnd">1dp</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:layout_marginBottom">2dp</item>

        <item name="android:background">@drawable/bg_glass_key</item>
        <item name="android:backgroundTint">@null</item>

        <item name="android:textColor">#17191C</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">normal</item>

        <item name="android:gravity">center</item>
        <item name="android:padding">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textAllCaps">false</item>

        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="KeyboardKeySmall" parent="KeyboardKey">
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="KeyboardActionKey" parent="KeyboardKey">
        <item name="android:background">@drawable/bg_glass_action</item>
    </style>

    <style name="KeyboardSpaceKey" parent="KeyboardKey">
        <item name="android:background">@drawable/bg_glass_space</item>
        <item name="android:textColor">#36393E</item>
    </style>

    <style name="KeyboardAccentKey" parent="KeyboardKey">
        <item name="android:background">@drawable/bg_glass_accent</item>
    </style>

</resources>
