package com.example.myapplication

import android.os.SystemClock
import android.util.Log
import com.google.ai.edge.litertlm.Backend
import com.google.ai.edge.litertlm.Contents
import com.google.ai.edge.litertlm.ConversationConfig
import com.google.ai.edge.litertlm.Engine
import com.google.ai.edge.litertlm.EngineConfig
import com.google.ai.edge.litertlm.SamplerConfig
import kotlinx.coroutines.CancellationException
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.withContext

class KeyboardLlm(
    private val modelPath: String
) {

    companion object {
        private const val TAG = "LLMKeyboard"
        private const val MAX_OUTPUT_TOKENS = 16
    }

    private var engine: Engine? = null

    @Volatile
    private var activeBackend = "NONE"

    // =========================================================
    // INITIALIZATION
    // =========================================================

    suspend fun initialize() =
        withContext(Dispatchers.IO) {

            if (engine?.isInitialized() == true) {
                Log.d(
                    TAG,
                    "LLM already initialized backend=$activeBackend"
                )
                return@withContext
            }

            // -------------------------------------------------
            // Try GPU first
            // -------------------------------------------------

            try {
                Log.i(TAG, "Trying GPU backend...")

                val start =
                    SystemClock.elapsedRealtime()

                val gpuEngine =
                    Engine(
                        EngineConfig(
                            modelPath = modelPath,
                            backend = Backend.GPU()
                        )
                    )

                gpuEngine.initialize()

                engine = gpuEngine
                activeBackend = "GPU"

                val elapsed =
                    SystemClock.elapsedRealtime() - start

                Log.i(
                    TAG,
                    "GPU initialized successfully in ${elapsed}ms"
                )

                return@withContext

            } catch (e: CancellationException) {
                throw e

            } catch (e: Exception) {

                Log.w(
                    TAG,
                    "GPU initialization failed. Falling back to CPU.",
                    e
                )

                closeEngineSafely()

                engine = null
                activeBackend = "NONE"
            }

            // -------------------------------------------------
            // CPU fallback
            // -------------------------------------------------

            Log.i(TAG, "Trying CPU backend...")

            val start =
                SystemClock.elapsedRealtime()

            val cpuEngine =
                Engine(
                    EngineConfig(
                        modelPath = modelPath,
                        backend = Backend.CPU()
                    )
                )

            cpuEngine.initialize()

            engine = cpuEngine
            activeBackend = "CPU"

            val elapsed =
                SystemClock.elapsedRealtime() - start

            Log.i(
                TAG,
                "CPU initialized successfully in ${elapsed}ms"
            )
        }

    // =========================================================
    // PUBLIC PREDICTION API
    // =========================================================

    suspend fun predict(
        context: String
    ): List<String> =
        withContext(Dispatchers.Default) {

            if (context.isBlank()) {
                return@withContext emptyList()
            }

            val currentEngine =
                engine ?: return@withContext emptyList()

            if (!currentEngine.isInitialized()) {
                return@withContext emptyList()
            }

            try {
                runPrediction(
                    currentEngine,
                    context
                )

            } catch (e: CancellationException) {
                throw e

            } catch (e: Exception) {

                /*
                 * GPU may initialize correctly but still fail during
                 * inference on some devices/drivers.
                 *
                 * If that happens, switch to CPU once.
                 */
                if (activeBackend == "GPU") {

                    Log.w(
                        TAG,
                        "GPU inference failed. Switching to CPU.",
                        e
                    )

                    switchToCpu()

                    val cpuEngine = engine

                    if (
                        cpuEngine != null &&
                        cpuEngine.isInitialized()
                    ) {
                        return@withContext runPrediction(
                            cpuEngine,
                            context
                        )
                    }
                }

                throw e
            }
        }

    // =========================================================
    // INFERENCE
    // =========================================================

    private fun runPrediction(
        currentEngine: Engine,
        context: String
    ): List<String> {

        val config =
            ConversationConfig(
                systemInstruction =
                    Contents.of(
                        """
                        You are the prediction engine of a smartphone keyboard.

                        Predict what the user is most likely to type immediately after the cursor.

                        Rules:
                        - Use the supplied context to understand the sentence.
                        - Each answer must add new text after the cursor.
                        - Do not simply repeat the supplied context.
                        - Return exactly 3 different likely continuations.
                        - Prefer natural next words or very short phrases.
                        - Keep every continuation concise.
                        - Separate the 3 continuations using |.
                        - Do not use numbering.
                        - Do not use bullet points.
                        - Do not use quotation marks.
                        - Do not include labels.
                        - Do not write "Next", "Suggestion", "Prediction", "Context", or "Output".
                        - Do not explain your answer.

                        Output only the 3 continuations separated by |.
                        """.trimIndent()
                    ),

                samplerConfig =
                    SamplerConfig(
                        topK = 20,
                        topP = 0.85,
                        temperature = 0.4
                    )
            )

        val cleanContext =
            context
                .takeLast(256)
                .trimStart()

        Log.d(
            TAG,
            "Inference START backend=$activeBackend context=${cleanContext.takeLast(80)}"
        )

        val start =
            SystemClock.elapsedRealtime()

        val predictions =
            currentEngine
                .createConversation(config)
                .use { conversation ->

                    /*
                     * IMPORTANT:
                     *
                     * No "Next:" suffix here.
                     * Qwen was copying that marker into its output.
                     */
                    val response =
                        conversation.sendMessage(
                            "Context: $cleanContext",
                            maxOutputToken = MAX_OUTPUT_TOKENS
                        )

                    parsePredictions(
                        response.toString()
                    )
                }

        val elapsed =
            SystemClock.elapsedRealtime() - start

        Log.i(
            TAG,
            "Inference DONE backend=$activeBackend time=${elapsed}ms predictions=$predictions"
        )

        return predictions
    }

    // =========================================================
    // OUTPUT PARSER
    // =========================================================

    private fun parsePredictions(
        rawResponse: String
    ): List<String> {

        return rawResponse
            /*
             * Accept both:
             *
             * hello|there|everyone
             *
             * and badly formatted multiline responses.
             */
            .split(
                Regex("[|\\n\\r]+")
            )
            .map { candidate ->

                cleanCandidate(candidate)
            }
            .filter { candidate ->

                candidate.isNotBlank() &&
                        !isGarbageCandidate(candidate)
            }
            .distinctBy { candidate ->

                candidate.lowercase()
            }
            .take(3)
    }

    // =========================================================
    // CLEAN ONE MODEL OUTPUT
    // =========================================================

    private fun cleanCandidate(
        value: String
    ): String {

        var result =
            value.trim()

        // Remove quotes
        result =
            result
                .removePrefix("\"")
                .removeSuffix("\"")
                .removePrefix("'")
                .removeSuffix("'")
                .trim()

        // Remove bullet characters
        result =
            result
                .removePrefix("-")
                .removePrefix("•")
                .removePrefix("*")
                .trim()

        // Remove numbering such as:
        // 1. hello
        // 2) there
        result =
            result.replace(
                Regex("^\\d+[.)]\\s*"),
                ""
            )

        /*
         * Remove labels if Qwen ignores the prompt.
         */
        result =
            result.replace(
                Regex(
                    "^(next|suggestion|prediction|output|context)\\s*:\\s*",
                    RegexOption.IGNORE_CASE
                ),
                ""
            )

        return result.trim()
    }

    // =========================================================
    // REJECT PLACEHOLDER / LABEL GARBAGE
    // =========================================================

    private fun isGarbageCandidate(
        candidate: String
    ): Boolean {

        val normalized =
            candidate
                .trim()
                .lowercase()

        val banned =
            setOf(
                "next",
                "next:",
                "suggestion",
                "suggestion:",
                "suggestion1",
                "suggestion2",
                "suggestion3",
                "suggestion 1",
                "suggestion 2",
                "suggestion 3",
                "prediction",
                "prediction:",
                "prediction1",
                "prediction2",
                "prediction3",
                "prediction 1",
                "prediction 2",
                "prediction 3",
                "context",
                "context:",
                "output",
                "output:"
            )

        return normalized in banned
    }

    // =========================================================
    // GPU -> CPU FALLBACK
    // =========================================================

    private fun switchToCpu() {

        closeEngineSafely()

        engine = null
        activeBackend = "NONE"

        Log.i(
            TAG,
            "Initializing CPU fallback..."
        )

        val start =
            SystemClock.elapsedRealtime()

        val cpuEngine =
            Engine(
                EngineConfig(
                    modelPath = modelPath,
                    backend = Backend.CPU()
                )
            )

        cpuEngine.initialize()

        engine = cpuEngine
        activeBackend = "CPU"

        val elapsed =
            SystemClock.elapsedRealtime() - start

        Log.i(
            TAG,
            "CPU fallback initialized in ${elapsed}ms"
        )
    }

    // =========================================================
    // SAFE ENGINE CLOSE
    // =========================================================

    private fun closeEngineSafely() {

        val currentEngine =
            engine ?: return

        try {
            if (currentEngine.isInitialized()) {
                currentEngine.close()
            }

        } catch (e: Exception) {

            Log.w(
                TAG,
                "Error while closing LiteRT engine",
                e
            )
        }
    }

    // =========================================================
    // CLEANUP
    // =========================================================

    fun close() {

        Log.d(
            TAG,
            "Closing LLM backend=$activeBackend"
        )

        closeEngineSafely()

        engine = null
        activeBackend = "NONE"
    }
}