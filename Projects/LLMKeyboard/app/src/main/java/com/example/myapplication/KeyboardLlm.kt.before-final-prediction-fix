package com.example.myapplication

import android.os.SystemClock
import android.util.Log
import com.google.ai.edge.litertlm.Backend
import com.google.ai.edge.litertlm.Contents
import com.google.ai.edge.litertlm.ConversationConfig
import com.google.ai.edge.litertlm.Engine
import com.google.ai.edge.litertlm.EngineConfig
import com.google.ai.edge.litertlm.SamplerConfig
import kotlinx.coroutines.CancellationException
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.withContext

class KeyboardLlm(
    private val modelPath: String
) {

    companion object {
        private const val TAG = "LLMKeyboard"
        private const val MAX_OUTPUT_TOKENS = 24
    }

    private var engine: Engine? = null

    @Volatile
    private var activeBackend = "NONE"

    // =========================================================
    // INITIALIZATION
    // =========================================================

    suspend fun initialize() =
        withContext(Dispatchers.IO) {

            if (engine?.isInitialized() == true) {
                Log.d(
                    TAG,
                    "LLM already initialized backend=$activeBackend"
                )
                return@withContext
            }

            // -------------------------------------------------
            // Try GPU first
            // -------------------------------------------------

            try {
                Log.i(TAG, "Trying GPU backend...")

                val start =
                    SystemClock.elapsedRealtime()

                val gpuEngine =
                    Engine(
                        EngineConfig(
                            modelPath = modelPath,
                            backend = Backend.GPU()
                        )
                    )

                gpuEngine.initialize()

                engine = gpuEngine
                activeBackend = "GPU"

                val elapsed =
                    SystemClock.elapsedRealtime() - start

                Log.i(
                    TAG,
                    "GPU initialized successfully in ${elapsed}ms"
                )

                return@withContext

            } catch (e: CancellationException) {
                throw e

            } catch (e: Exception) {

                Log.w(
                    TAG,
                    "GPU initialization failed. Falling back to CPU.",
                    e
                )

                closeEngineSafely()

                engine = null
                activeBackend = "NONE"
            }

            // -------------------------------------------------
            // CPU fallback
            // -------------------------------------------------

            Log.i(TAG, "Trying CPU backend...")

            val start =
                SystemClock.elapsedRealtime()

            val cpuEngine =
                Engine(
                    EngineConfig(
                        modelPath = modelPath,
                        backend = Backend.CPU()
                    )
                )

            cpuEngine.initialize()

            engine = cpuEngine
            activeBackend = "CPU"

            val elapsed =
                SystemClock.elapsedRealtime() - start

            Log.i(
                TAG,
                "CPU initialized successfully in ${elapsed}ms"
            )
        }

    // =========================================================
    // PUBLIC PREDICTION API
    // =========================================================

    suspend fun predict(
        context: String
    ): List<String> =
        withContext(Dispatchers.Default) {

            if (context.isBlank()) {
                return@withContext emptyList()
            }

            val currentEngine =
                engine ?: return@withContext emptyList()

            if (!currentEngine.isInitialized()) {
                return@withContext emptyList()
            }

            try {
                runPrediction(
                    currentEngine,
                    context
                )

            } catch (e: CancellationException) {
                throw e

            } catch (e: Exception) {

                /*
                 * GPU may initialize correctly but still fail during
                 * inference on some devices/drivers.
                 *
                 * If that happens, switch to CPU once.
                 */
                if (activeBackend == "GPU") {

                    Log.w(
                        TAG,
                        "GPU inference failed. Switching to CPU.",
                        e
                    )

                    switchToCpu()

                    val cpuEngine = engine

                    if (
                        cpuEngine != null &&
                        cpuEngine.isInitialized()
                    ) {
                        return@withContext runPrediction(
                            cpuEngine,
                            context
                        )
                    }
                }

                throw e
            }
        }

    // =========================================================
    // INFERENCE
    // =========================================================

    private fun runPrediction(
        currentEngine: Engine,
        context: String
    ): List<String> {

        val cleanContext =
            context
                .takeLast(256)
                .trimStart()

        /*
         * Word completion is handled by LocalSuggestionEngine.
         *
         * Qwen has exactly ONE responsibility:
         * contextual NEXT-WORD prediction after a word boundary.
         */
        val config =
            ConversationConfig(

                systemInstruction =
                    Contents.of(
                        """
                        You are a next-word prediction component for a smartphone keyboard.

                        Given text immediately before the cursor, return exactly three likely next words.

                        Requirements:
                        - Predict words that naturally continue the supplied text.
                        - Use grammar and meaning from the supplied text.
                        - Each candidate must be exactly one word.
                        - Candidates must be different.
                        - Prefer common conversational wording.
                        - Contractions and hyphenated words are allowed.
                        - Do not repeat the entire context.
                        - Do not write sentences or phrases.
                        - Do not number the candidates.
                        - Do not use bullets.
                        - Do not use quotation marks.
                        - Do not add labels.
                        - Do not explain the result.
                        - Separate the three candidates using the vertical bar character.
                        - Output candidates only.
                        """.trimIndent()
                    ),

                samplerConfig =
                    SamplerConfig(
                        topK = 30,
                        topP = 0.90,
                        temperature = 0.55
                    )
            )

        Log.d(
            TAG,
            "Inference START backend=$activeBackend mode=NEXT_WORD context=${cleanContext.takeLast(80)}"
        )

        val start =
            SystemClock.elapsedRealtime()

        val predictions =
            currentEngine
                .createConversation(
                    config
                )
                .use { conversation ->

                    /*
                     * Deliberately no example answers here.
                     *
                     * Tiny models can copy example candidates instead
                     * of actually predicting from the user's context.
                     */
                    val response =
                        conversation.sendMessage(
                            """
                            Text before cursor:
                            $cleanContext
                            """.trimIndent(),
                            maxOutputToken =
                                MAX_OUTPUT_TOKENS
                        )

                    parsePredictions(
                        rawResponse =
                            response.toString(),

                        requiredPrefix =
                            null
                    )
                }

        val elapsed =
            SystemClock.elapsedRealtime() -
                start

        Log.i(
            TAG,
            "Inference DONE backend=$activeBackend time=${elapsed}ms predictions=$predictions"
        )

        return predictions
    }

    // =========================================================
    // OUTPUT PARSER
    // =========================================================

    private fun parsePredictions(
        rawResponse: String,
        requiredPrefix: String?
    ): List<String> {

        return rawResponse

            /*
             * Expected:
             *
             * hello|help|helmet
             *
             * Newlines are tolerated because small models sometimes
             * ignore formatting instructions.
             */
            .split(
                Regex("[|\n\r]+")
            )

            .map { candidate ->

                cleanCandidate(
                    candidate
                )
            }

            /*
             * Remove harmless punctuation / markdown that a model may
             * wrap around an otherwise valid word.
             */
            .map { candidate ->

                candidate
                    .trim()
                    .trim(
                        '`',
                        '*',
                        '"',
                        '\'',
                        ',',
                        '.',
                        ';',
                        ':',
                        '!',
                        '?'
                    )
                    .trim()
            }

            /*
             * A suggestion-strip candidate must be a WORD,
             * not another generated sentence.
             */
            .filter { candidate ->

                candidate.isNotBlank() &&
                        candidate.length <= 32 &&
                        candidate.matches(
                            Regex(
                                "^[\\p{L}][\\p{L}'’-]*$"
                            )
                        ) &&
                        !isGarbageCandidate(
                            candidate
                        )
            }

            /*
             * During completion:
             *
             * typed "hel"
             *
             * accept:
             * hello
             * help
             * helmet
             *
             * reject:
             * world
             * hel
             */
            .filter { candidate ->

                requiredPrefix == null ||
                        (
                            candidate.length >
                                    requiredPrefix.length &&

                                    candidate.startsWith(
                                        requiredPrefix,
                                        ignoreCase = true
                                    )
                            )
            }

            .distinctBy { candidate ->

                candidate.lowercase()
            }

            .take(3)
    }

    // =========================================================
    // CLEAN ONE MODEL OUTPUT
    // =========================================================

    private fun cleanCandidate(
        value: String
    ): String {

        var result =
            value.trim()

        // Remove quotes
        result =
            result
                .removePrefix("\"")
                .removeSuffix("\"")
                .removePrefix("'")
                .removeSuffix("'")
                .trim()

        // Remove bullet characters
        result =
            result
                .removePrefix("-")
                .removePrefix("•")
                .removePrefix("*")
                .trim()

        // Remove numbering such as:
        // 1. hello
        // 2) there
        result =
            result.replace(
                Regex("^\\d+[.)]\\s*"),
                ""
            )

        /*
         * Remove labels if Qwen ignores the prompt.
         */
        result =
            result.replace(
                Regex(
                    "^(next|suggestion|prediction|output|context)\\s*:\\s*",
                    RegexOption.IGNORE_CASE
                ),
                ""
            )

        return result.trim()
    }

    // =========================================================
    // REJECT PLACEHOLDER / LABEL GARBAGE
    // =========================================================

    private fun isGarbageCandidate(
        candidate: String
    ): Boolean {

        val normalized =
            candidate
                .trim()
                .lowercase()

        val banned =
            setOf(
                "next",
                "next:",
                "suggestion",
                "suggestion:",
                "suggestion1",
                "suggestion2",
                "suggestion3",
                "suggestion 1",
                "suggestion 2",
                "suggestion 3",
                "prediction",
                "prediction:",
                "prediction1",
                "prediction2",
                "prediction3",
                "prediction 1",
                "prediction 2",
                "prediction 3",
                "context",
                "context:",
                "output",
                "output:"
            )

        return normalized in banned
    }

    // =========================================================
    // GPU -> CPU FALLBACK
    // =========================================================

    private fun switchToCpu() {

        closeEngineSafely()

        engine = null
        activeBackend = "NONE"

        Log.i(
            TAG,
            "Initializing CPU fallback..."
        )

        val start =
            SystemClock.elapsedRealtime()

        val cpuEngine =
            Engine(
                EngineConfig(
                    modelPath = modelPath,
                    backend = Backend.CPU()
                )
            )

        cpuEngine.initialize()

        engine = cpuEngine
        activeBackend = "CPU"

        val elapsed =
            SystemClock.elapsedRealtime() - start

        Log.i(
            TAG,
            "CPU fallback initialized in ${elapsed}ms"
        )
    }

    // =========================================================
    // SAFE ENGINE CLOSE
    // =========================================================

    private fun closeEngineSafely() {

        val currentEngine =
            engine ?: return

        try {
            if (currentEngine.isInitialized()) {
                currentEngine.close()
            }

        } catch (e: Exception) {

            Log.w(
                TAG,
                "Error while closing LiteRT engine",
                e
            )
        }
    }

    // =========================================================
    // CLEANUP
    // =========================================================

    fun close() {

        Log.d(
            TAG,
            "Closing LLM backend=$activeBackend"
        )

        closeEngineSafely()

        engine = null
        activeBackend = "NONE"
    }
}